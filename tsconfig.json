{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun"]
  },
  "include": ["packages/protocol", "packages/client", "packages/server", "packages/pi", "packages/atxf"],
  "exclude": ["**/node_modules"]
}
