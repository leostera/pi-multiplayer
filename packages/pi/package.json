{
  "name": "@pi-multiplayer/pi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pi extension: join a pi-multiplayer session from Pi",
  "exports": {
    ".": "./src/extension.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "dependencies": {
    "@pi-multiplayer/client": "workspace:*",
    "@pi-multiplayer/protocol": "workspace:*",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@pi-multiplayer/server": "workspace:*",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0"
  }
}
